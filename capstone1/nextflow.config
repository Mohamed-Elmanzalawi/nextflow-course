// Capstone 1 configuration: you don't need to change this file.

// Fail tasks on errors anywhere in a pipe (Lesson 4.3)
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Publish real copies, not links into work/ (Lesson 3.3)
workflow.output.mode = 'copy'

profiles {
    docker {
        docker.enabled = true
        // BioContainers images are amd64-only; this runs them on Apple Silicon too (Lesson 2.3)
        docker.runOptions = '--platform linux/amd64'
    }
    conda {
        conda.enabled = true
    }
}
